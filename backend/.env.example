# ABHAYA – Women's Safety and Support Portal Backend Configuration
# Copy this file to backend/.env for local development, or configure these in Vercel Environment Variables.

DJANGO_SECRET_KEY=replace-with-a-strong-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# Production Database Configuration (External PostgreSQL via DATABASE_URL)
DATABASE_URL=postgresql://username:password@ep-example-pooler.region.aws.neon.tech/abhaya?sslmode=require
DB_SSL_REQUIRE=True
DB_CONN_MAX_AGE=0

# Local Development Database Fallback (used only when DJANGO_DEBUG=True and DATABASE_URL is unset)
DB_FALLBACK_SQLITE=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=abhaya_db
DB_USER=postgres
DB_PASSWORD=replace-with-local-db-password
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS & CSRF Frontend Origin Configuration (set to your exact frontend Vercel domain in production)
CORS_ALLOWED_ORIGINS=https://your-frontend-project.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://your-frontend-project.vercel.app,https://your-backend-project.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=120
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=None

# Optional External Object Storage (S3 / Cloudflare R2 / Supabase Storage) for Complaint Attachments
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=

# Configurable SMTP Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.edu.in
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=abhaya-noreply@college.edu.in
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=ABHAYA Women's Safety Portal <abhaya-noreply@college.edu.in>

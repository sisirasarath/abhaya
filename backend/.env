# ABHAYA – Women's Safety and Support Portal Backend Configuration
DJANGO_SECRET_KEY=abhaya-secure-college-union-womens-safety-portal-secret-key-2026-27
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Primary Database Configuration: PostgreSQL (with automatic local fallback when PG daemon is offline)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=abhaya_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_FALLBACK_SQLITE=True

# CORS & Frontend Integration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# JWT Authentication Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=120
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax

# Configurable SMTP Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.edu.in
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=abhaya-noreply@college.edu.in
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ABHAYA Women's Safety Portal <abhaya-noreply@college.edu.in>

